<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.matsui.nana.historygame">

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Historygame">
        <activity
            android:name=".ScoreActivity"
            android:label="@string/title_activity_score"
            android:exported="true">
        </activity>

        <activity
            android:name=".FirstActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AnswerActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".GameoverActivity" />
        <activity android:name=".TutorialActivity" />
        <activity android:name=".Tutorial2Activity" />
        <activity android:name=".Tutorial3Activity" />
        <activity android:name=".Tutorial4Activity" />
        <activity android:name=".Tutorial5Activity" />
        <activity android:name=".Tutorial6Activity" />
        <activity android:name=".Tutorial7Activity" />
        <activity android:name=".TimeMainActivity" />
    </application>

</manifest>